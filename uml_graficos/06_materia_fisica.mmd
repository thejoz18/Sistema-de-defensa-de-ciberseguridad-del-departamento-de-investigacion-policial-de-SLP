flowchart TD
    A["Entradas"] --> B["flujo digital"]
    A --> C["cpu_base"]
    A --> D["estado del sistema"]
    A --> E["temperatura calculada"]

    B --> F["CPU = cpu_base + 0.035 * flujo"]
    C --> F
    F --> G["Potencia CPU = CPU/100 * 120 W"]
    G --> H["Temperatura = ambiente + potencia * factor"]

    H --> I["Ventilador siempre activo"]
    I --> J{"Temperatura >= U_TEMP_REFRIG?"}
    J -->|No| K["Baja por ventilacion normal"]
    J -->|Si| L["Ventilador acelera 30%"]
    L --> M["Refrigeracion por fluido"]

    M --> N{"Estado CRITICO?"}
    N -->|No| O["Continuidad: velocidad base y caudal"]
    N -->|Si| P["Bernoulli: aumentar presion de entrada"]

    K --> Q["Salida: temperatura final"]
    O --> Q
    P --> Q
    Q --> R["Salida: consumo total watts"]
    R --> S["Grafica 03 temperatura"]
